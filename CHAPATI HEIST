-- 1. Display all records
SELECT * FROM suspects;

-- 2. Display names and roles only
SELECT name, role FROM suspects;

-- 3. Display suspects last seen in the cafeteria
SELECT * FROM suspects
WHERE last_seen_place = 'cafeteria';

-- 4. Display all students
SELECT * FROM suspects
WHERE role = 'student';

-- 5. Display suspects with no alibi
SELECT * FROM suspects
WHERE alibi IS NULL;

-- 6. Display lecturers and security personnel
SELECT * FROM suspects
WHERE role IN ('lecturer', 'security');

-- 7. Display the first 3 suspects by time seen
SELECT * FROM suspects
ORDER BY time_seen ASC
LIMIT 3;

-- 8. Display unique places where suspects were last seen
SELECT DISTINCT last_seen_place FROM suspects;
