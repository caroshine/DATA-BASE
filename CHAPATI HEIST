DROP table suspects;
CREADTE TABLE suspects (
    suspect_id INT PRIMARY KEY,
    name VARCHAR(50),
    role VARCHAR(20),
    last_seen_place VARCHAR(20),
    time_seen TIME,
    carrying VARCHAR(20),
    shoe_size INT,
    alibi VARCHAR(100)
);

